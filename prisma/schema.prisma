// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Use environment variables to switch between local and production
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Connection string with pooling if available
  directUrl = env("DIRECT_URL") // Direct connection string for migrations
}

model Participant {
  id          String   @id @default(cuid())
  name        String
  email       String
  username    String
  phone       String?
  appliedDate DateTime @default(now())

  @@map("participants")
}
